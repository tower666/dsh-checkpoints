{
  "name": "dsh-checkpoints",
  "version": "1.1.0",
  "type": "module",
  "description": "Per-turn git checkpoints of the workspace with a previewed, undoable revert: undo one turn's changes, or go back to the end of an earlier turn",
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "dsh",
    "deepseek-harness",
    "checkpoint",
    "checkpoints",
    "revert",
    "snapshot",
    "git",
    "shadow-repository"
  ],
  "license": "MIT",
  "author": "fff",
  "homepage": "https://github.com/tower666/dsh-checkpoints#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tower666/dsh-checkpoints.git"
  },
  "bugs": {
    "url": "https://github.com/tower666/dsh-checkpoints/issues"
  },
  "engines": {
    "dsh": "^0.2.1-rc.3",
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
